# make               generate file list, synthesize, fit, assemble, sta -> quartus/output_files/$(PROJ).sof
# make prog          program the fpga over jtag
# make sw            build sw/$(APP) -> sw/$(APP)/neorv32_exe.bin
# make upload        send that binary to the neorv32 bootloader over uart (press KEY0 first)
# make sim           simulate tb/$(TB).vhd with $(SIM) = ghdl | questa
# make clean         remove build artifacts
#
# examples
#   make sim TB=tb_sobel SIM=questa WAVES=1
#   make upload APP=blink UART_TTY=/dev/ttyUSB0
#   make sw RISCV_PREFIX=riscv64-unknown-elf-

PROJ     ?= rvedgedet
APP      ?= lcddemo
TB       ?= tb
SIM      ?= ghdl
WAVES    ?= 0
GUI      ?= 0
# 1 = also compile the neorv32 library into the simulation
WITH_NEORV32 ?= 0

# quartus tool flags
QFLAGS   ?=
# e.g. make prog CABLE=1 (see jtagconfig); empty = auto-detect
CABLE    ?=
# jtag chain position, only needed if the fpga isn't the first device
POS      ?=
UART_TTY ?= /dev/ttyUSB0

N32      := ext/neorv32
QDIR     := quartus
SOF      := $(QDIR)/output_files/$(PROJ).sof

# everything quartus has to compile besides neorv32
RTL_SRC  := $(sort $(wildcard rtl/*.vhd rtl/*/*.vhd))
N32_LIST := $(N32)/rtl/file_list_core.f
N32_SRC  := $(patsubst $$NEORV32_HOME/%,$(N32)/%,$(shell cat $(N32_LIST) 2>/dev/null))

# accelerator sources for simulation (top.vhd and the board glue stay out).
# compile order matters for questa: list files in dependency order in rtl/accel/files.f
# (one path per line, relative to this directory, '#' comments allowed). without that
# file it falls back to *_pkg.vhd first, then the rest alphabetically.
ACCEL_LIST := rtl/accel/files.f
ACCEL_SRC  := $(if $(wildcard $(ACCEL_LIST)),$(shell sed -e 's/\#.*//' $(ACCEL_LIST)),\
                $(sort $(wildcard rtl/accel/*_pkg.vhd)) \
                $(filter-out %_pkg.vhd,$(sort $(wildcard rtl/accel/*.vhd))))
TB_SRC     := tb/$(TB).vhd

.PHONY: all compile prog sw sw-check upload sim sim-ghdl sim-questa clean distclean

all: compile
compile: $(SOF)

# QUARTUS
# the qsf stays static; it sources files.tcl, which lists neorv32 (library neorv32) and rtl/**
$(QDIR)/files.tcl: $(N32_LIST) $(RTL_SRC) Makefile
	@echo "# generated by make, do not edit" > $@
	@sed -e 's|^\$$NEORV32_HOME|../$(N32)|' \
	     -e 's|^\(.*\)$$|set_global_assignment -name VHDL_FILE \1 -library neorv32|' $(N32_LIST) >> $@
	@for f in $(RTL_SRC); do echo "set_global_assignment -name VHDL_FILE ../$$f" >> $@; done
	@echo "generated $@ ($(words $(N32_SRC)) neorv32 files, $(words $(RTL_SRC)) project files)"

$(SOF): $(QDIR)/files.tcl $(QDIR)/$(PROJ).qsf $(QDIR)/$(PROJ).sdc $(QDIR)/pins.tcl $(RTL_SRC) $(N32_SRC)
	cd $(QDIR) && quartus_sh $(QFLAGS) --flow compile $(PROJ)

prog: $(SOF)
	quartus_pgm $(QFLAGS) -m jtag $(if $(CABLE),-c "$(CABLE)") -o "p;$(SOF)$(if $(POS),@$(POS))"

# SOFTWARE (BOOTLOADER FLOW)
sw:
	$(MAKE) -C sw/$(APP) exe

sw-check:
	$(MAKE) -C sw/$(APP) check

upload: sw
	stty -F $(UART_TTY) 19200 raw -echo -hup cs8 -cstopb clocal cread
	printf ' ' > $(UART_TTY)
	sleep 0.25
	$(MAKE) -C sw/$(APP) upload UART_TTY=$(UART_TTY)

# SIMULATION
sim: sim-$(SIM)

# ghdl
sim-ghdl:
	mkdir -p build/ghdl
	cd build/ghdl && set -e; \
	$(if $(filter 1,$(WITH_NEORV32)),for f in $(addprefix ../../,$(N32_SRC)); do ghdl -i --std=08 --work=neorv32 $$f; done;) \
	ghdl -i --std=08 $(addprefix ../../,$(ACCEL_SRC) $(TB_SRC)); \
	ghdl -m --std=08 $(TB); \
	ghdl -r --std=08 $(TB) --ieee-asserts=disable-at-0 $(if $(filter 1,$(WAVES)),--wave=$(TB).ghw)

# questa
sim-questa:
	mkdir -p build/questa
	cd build/questa && set -e; \
	vlib work && vmap work work; \
	$(if $(filter 1,$(WITH_NEORV32)),vlib neorv32 && vmap neorv32 neorv32 && vcom -2008 -quiet -work neorv32 $(addprefix ../../,$(N32_SRC));) \
	vcom -2008 -quiet -work work $(addprefix ../../,$(ACCEL_SRC) $(TB_SRC)); \
	vsim $(if $(filter 1,$(GUI)),,-c) $(if $(filter 1,$(WAVES)),-voptargs=+acc -wlf $(TB).wlf) work.$(TB) \
	     -do "$(if $(filter 1,$(GUI)),,onbreak {quit -f -code 1};) $(if $(filter 1,$(WAVES)),log -r /*;) run -all$(if $(filter 1,$(GUI)),,; quit -f)"

# CLEANUP
clean:
	rm -rf $(QDIR)/db $(QDIR)/incremental_db $(QDIR)/output_files $(QDIR)/qdb $(QDIR)/files.tcl build
	rm -f $(QDIR)/*_pin_model_dump.txt

distclean: clean
	-$(MAKE) -C sw/$(APP) clean_all
